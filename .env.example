# Hosted embed CDN (Cloudflare Worker). Copy to .env.local to enable.
#
# Leave both blank and Forge still works: generate succeeds, the job is marked
# publishStatus="skipped", and site owners use the self-host download instead.
#
# CDN_BASE_URL is the deployed Worker origin, no trailing slash.
CDN_BASE_URL=
# CDN_PUBLISH_TOKEN must equal the Worker's PUBLISH_TOKEN secret, set with
# `npx wrangler secret put PUBLISH_TOKEN -c cdn/wrangler.jsonc`.
CDN_PUBLISH_TOKEN=

# Which browser the scanner drives: "chrome" (default) or "lightpanda".
# Lightpanda uses about a twentieth of the memory because it has no rendering
# engine, which the scanner never needed: it only reads the DOM. It is a
# nightly build, so Chrome stays the default.
#   docker compose --profile lightpanda up -d
SCANNER_ENGINE=
# Where the Lightpanda server listens. Ignored when the engine is chrome.
# Use http://lightpanda:9222 with the compose profile above.
SCANNER_CDP_URL=
