# Hosted embed CDN (Cloudflare Worker). Copy to .env.local to enable.
#
# Leave both blank and Forge still works: generate succeeds, the job is marked
# publishStatus="skipped", and site owners use the self-host download instead.
#
# CDN_BASE_URL is the deployed Worker origin, no trailing slash.
CDN_BASE_URL=
# CDN_PUBLISH_TOKEN must equal the Worker's PUBLISH_TOKEN secret, set with
# `npx wrangler secret put PUBLISH_TOKEN -c cdn/wrangler.jsonc`.
CDN_PUBLISH_TOKEN=

# Which browser the scanner drives: "chrome" (default) or "lightpanda".
# Lightpanda uses about a twentieth of the memory because it has no rendering
# engine, which the scanner never needed: it only reads the DOM. It is a
# nightly build, so Chrome stays the default.
#   docker compose --profile lightpanda up -d
SCANNER_ENGINE=
# Where the Lightpanda server listens. Ignored when the engine is chrome.
# Use http://127.0.0.1:9222 with the compose profile above: the browser shares
# the app's network namespace, so it answers on the app's own loopback.
SCANNER_CDP_URL=

# Limits on /api/scan. The endpoint is public and a scan costs a browser, on a
# box shared with someone else's production service, so these exist to keep one
# caller from spending all of it. All optional; the defaults shown are what the
# code uses when the variable is absent.
#
# Counted per client address — IPv4 whole, IPv6 by /64, because a home
# connection is handed a /64 and counting single addresses would let one
# visitor take a fresh allowance per request.
SCAN_RATE_WINDOW_MS=30000
SCAN_RATE_MAX_PER_WINDOW=1
SCAN_RATE_MAX_PER_DAY=20
# Everyone whose address could not be read shares one allowance, so it is
# deliberately roomier: sized like a per-address limit it would be a way to
# lock out the whole service.
SCAN_RATE_UNKNOWN_PER_DAY=200
# Scans running at once. Start at 1 and raise it only against a measurement of
# two real scans in parallel — the estimates in docker-compose.yml, the
# deployment guide and the plan reports disagree with each other.
SCAN_MAX_CONCURRENT=1
SCAN_RATE_MAP_MAX=20000
# Set to 1 to switch the limits off. The test suite does this; production
# should not.
SCAN_RATE_LIMIT_DISABLED=

# How long to wait for a browser before giving up. Launching one, or connecting
# to one over CDP, is the only wait on the scan path without a timeout of its
# own. Default 20000.
BROWSER_ACQUIRE_TIMEOUT_MS=

# Kill switch for the check that runs after navigation, so a bad day can be
# handled with a restart instead of a rebuild. Anything other than "0" leaves
# it on.
SCAN_ENFORCE_CONNECTED_IP=
