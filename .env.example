# Hosted embed CDN (Cloudflare Worker). Copy to .env.local to enable.
#
# Leave both blank and Forge still works: generate succeeds, the job is marked
# publishStatus="skipped", and site owners use the self-host download instead.
#
# CDN_BASE_URL is the deployed Worker origin, no trailing slash.
CDN_BASE_URL=
# CDN_PUBLISH_TOKEN must equal the Worker's PUBLISH_TOKEN secret, set with
# `npx wrangler secret put PUBLISH_TOKEN -c cdn/wrangler.jsonc`.
CDN_PUBLISH_TOKEN=
